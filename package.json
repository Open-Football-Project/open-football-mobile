{
  "name": "open-football-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start-no-cache": "react-native start -- --reset-cache",
    "test": "jest",
    "assembleDebug": "cd android && ./gradlew clean assembleDebug",
    "assembleRelease": "cd android && ./gradlew assembleRelease",
    "androidBuild": "cd android && ./gradlew clean build",
    "androidClean": "rm -rf android/app/.cxx android/app/build",
    "installDebug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "installRelease": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "startPhone": "emulator -avd phone2 -no-snapshot-load -no-snapshot-save -gpu swiftshader_indirect",
    "startTablet": "emulator -avd tabletTest -no-snapshot-load -no-snapshot-save -gpu swiftshader_indirect",
    "startDesktop": "emulator -avd desktopLarge -no-snapshot-load -no-snapshot-save -gpu swiftshader_indirect",
    "emuPortFix": "adb reverse tcp:8081 tcp:8081"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@tanstack/react-query": "^5.90.21",
    "i18next": "^25.8.11",
    "open-football-project-core": "github:Open-Football-Project/open-football-ui-core",
    "react": "19.2.3",
    "react-i18next": "^16.5.4",
    "react-native": "0.84.0",
    "react-native-config": "^1.6.1",
    "react-native-feather": "^2.0.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-share": "^12.2.6",
    "react-native-size-matters": "^0.4.2",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "^15.15.3",
    "react-native-view-shot": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.0",
    "@react-native/eslint-config": "0.84.0",
    "@react-native/metro-config": "0.84.0",
    "@react-native/typescript-config": "0.84.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.72.8",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ajv": ">=8.18.0",
    "minimatch": ">=10.2.1",
    "fast-xml-parser": ">=5.3.6",
    "glob": ">=10.2.1",
    "qs": ">=6.14.1",
    "tough-cookie": ">=4.1.3",
    "node-notifier": ">=8.0.1"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
